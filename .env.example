# Ubuntu Kreative Village — Environment Variables

# ─── SANITY CMS ────────────────────────────────────────────────────────────
# Required for Ubuntu Journal and other CMS-powered features
NEXT_PUBLIC_SANITY_PROJECT_ID=09xi8mov
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ─── SUPABASE AUTHENTICATION ───────────────────────────────────────────────
# Database and auth for bookings, user accounts, etc.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── STRIPE PAYMENTS ──────────────────────────────────────────────────────
# Payment processing for bookings and purchases
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# ─── EMAIL SERVICE ────────────────────────────────────────────────────────
# For sending booking confirmations, newsletters, etc.
RESEND_API_KEY=

# ─── AI SERVICES ──────────────────────────────────────────────────────────
# OpenAI for Moxie chatbot and AI features
OPENAI_API_KEY=

# ─── ANALYTICS & MONITORING ───────────────────────────────────────────────
# Google Analytics
NEXT_PUBLIC_GA_ID=

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=

# ─── DEVELOPMENT ──────────────────────────────────────────────────────────
NODE_ENV=development
